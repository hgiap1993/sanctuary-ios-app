{
  "expo": {
    "name": "Sanctuary",
    "slug": "sanctuary-12-sacred-vessels",
    "version": "1.1.0",
    "newArchEnabled": false,
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0b0805",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0b0805"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.sacredvessels.jesuswords",
      "infoPlist": {
        "CFBundleDisplayName": "Sanctuary",
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": [
          "audio"
        ],
        "NSMicrophoneUsageDescription": "Sanctuary does not record your voice; audio permissions are used solely for peaceful ambient harp and scripture playback."
      }
    },
    "android": {
      "package": "com.sacredvessels.jesuswords",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0b0805"
      },
      "permissions": [
        "INTERNET",
        "VIBRATE"
      ]
    },
    "extra": {
      "eas": {
        "projectId": "be6bc40d-e5da-4c42-b719-cf6f565a16c4"
      }
    },
    "owner": "phanxicovos-team",
    "plugins": [
      "expo-asset",
      "react-native-iap",
      "./withFixRNIapAndroid.js"
    ]
  }
}
